{
  // Static-assets deploy for the APEX web app (Cloudflare Workers Static Assets).
  // Run `npm run build` first — Vite emits the site into ./dist.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deepstash",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    // Single-page app: serve index.html for any unknown path.
    "not_found_handling": "single-page-application"
  }
}
